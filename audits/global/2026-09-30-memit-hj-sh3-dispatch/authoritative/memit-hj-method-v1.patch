@@ -0,0 +1,31 @@
+"""MEMIT-HJ v3 history maintenance -- reference (NumPy).
+
+MEMIT-H stores H_l = sum of post-write key outer products. With all layers written every batch, writes
+below layer l move layer-l keys of past requests, so H_l describes old keys (the lowest edited layer is
+exact). Rule: compare a stored sample of post-write keys with the same requests' keys at the current state;
+refresh layer l when the median relative drift exceeds the median context dispersion of the key recipe
+(the variation the native context-averaged key already treats as noise).
+"""
+import numpy as np
+
+
+def relative_drift(K_old, K_new):
+    """Per-request ||k_new - k_old|| / ||k_old||; K arrays are (d_in, N)."""
+    return np.linalg.norm(K_new - K_old, axis=0) / np.linalg.norm(K_old, axis=0)
+
+
+def context_dispersion(K_ctx):
+    """K_ctx (C, d_in, N) per-context keys -> sqrt(mean_c ||k_c - k_bar||^2) / ||k_bar|| per request."""
+    kbar = K_ctx.mean(axis=0)
+    spread = np.sqrt(np.mean(np.sum((K_ctx - kbar[None]) ** 2, axis=1), axis=0))
+    return spread / np.linalg.norm(kbar, axis=0)
+
+
+def refresh_needed(drift, dispersion):
+    """Refresh when the typical drift exceeds the typical resolution of the key itself."""
+    return bool(np.median(drift) > np.median(dispersion))
+
+
+def rebuild_history(K_all_current):
+    """H_l from the current keys of every committed request (native membership)."""
+    return K_all_current @ K_all_current.T
diff --git a/project/run_scripts/memit_hj/test_memit_hj.py b/project/run_scripts/memit_hj/test_memit_hj.py
