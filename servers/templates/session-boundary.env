# Copy to servers/local/session-boundary.env on each clone and fill it locally.
# This file contains coordination identifiers, not credentials. Do not put a
# token, password, SSH key path, raw endpoint, or private dataset secret here.
ODEEDIT_REPOSITORY_ID=hyunjun1127/ODE-edit
ODEEDIT_REPOSITORY_CWD=/absolute/path/to/ODE-edit
ODEEDIT_CODEX_SESSION_ID=
ODEEDIT_REQUIRED_CODEX_MODEL_PROFILE='Terra Ultra'
# Fill only after confirming the displayed model for this exact Codex session.
ODEEDIT_CONFIRMED_CODEX_MODEL_PROFILE=
ODEEDIT_CURRENT_SERVER=
